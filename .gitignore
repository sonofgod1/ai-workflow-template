# Secretos
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Bases de datos locales (NUNCA versionar)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Graphify — regenerar local, no commitear outputs
graphify-out/*
!graphify-out/.gitkeep

# AI Workflow
.ai-workflow/

# TypeScript build cache
*.tsbuildinfo
**/tsconfig.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/

# Node
node_modules/
**/node_modules/
.next/
**/.next/
dist/
build/

# Editor y OS
.DS_Store
**/.DS_Store
*.log

# Aider (si se usó antes)
.aider.*

# Registro de sincronización del workflow (local, no versionar)
.claude/.workflow-sync

# Estado del workflow: fase activa y evidencia de la última verificación.
# Es estado de sesión, no del proyecto. verify.conf SÍ se versiona: define
# cómo se verifica este repo.
.workflow/.phase.json
.workflow/.last-verify.json

# Logs y worktrees de batch.sh: son de una corrida, no del proyecto.
.workflow/.batch-logs/
.worktrees/

# delivery.conf NO está aquí a propósito: la autorización de entrega es una
# decisión del proyecto, así que se versiona y se revisa como cualquier otro
# cambio. Está en .claude/protected.txt para que el agente no pueda escribirla.

# Lista de archivos protegidos específica de esta copia del repo. No se versiona:
# si se clonara a un proyecto nuevo, le desactivaría protecciones que ahí sí aplican.
.claude/protected.local.txt
