#!/usr/bin/env bash
# git-hooks/pre-commit
# Corre antes de cada commit del usuario.
# Instalar con: cp git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# O usar /git-setup que lo hace automáticamente.

set -e

echo "🔍 pre-commit: verificando cambios..."

# ─── Archivos staged en este commit ───────────────────────────────────────────

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo "✓ Sin archivos staged para revisar."
  exit 0
fi

EXIT_CODE=0

# ─── 1. Archivos prohibidos ───────────────────────────────────────────────────

echo "  Verificando archivos prohibidos..."

FORBIDDEN_PATTERNS=(
  "\.env$"
  "\.env\.local$"
  "\.env\.production$"
  "\.env\.staging$"
  "node_modules/"
  "\.tsbuildinfo$"
  "\.db$"
  "\.sqlite$"
  "\.sqlite3$"
  "dist/"
  "build/"
  "\.DS_Store$"
  "Thumbs\.db$"
  "\.pem$"
  "\.key$"
  "\.p12$"
  "__pycache__/"
  "\.pyc$"
)

for file in $STAGED_FILES; do
  for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
    if echo "$file" | grep -qE "$pattern"; then
      echo "  ❌ Archivo prohibido en commit: $file"
      echo "     Patrón: $pattern"
      echo "     Agrega este archivo a .gitignore y quítalo del staging:"
      echo "     git rm --cached $file"
      EXIT_CODE=1
    fi
  done
done

if [ $EXIT_CODE -ne 0 ]; then
  exit $EXIT_CODE
fi

echo "  ✓ Sin archivos prohibidos."

# ─── 2. Detectar stack ────────────────────────────────────────────────────────

HAS_NODE=$([ -f "package.json" ] && echo "yes" || true)
HAS_PYTHON=$(( [ -f "pyproject.toml" ] || [ -f "setup.py" ] ) && echo "yes" || true)
HAS_BIOME=$([ -f "node_modules/.bin/biome" ] && echo "yes" || true)
HAS_ESLINT=$([ -f "node_modules/.bin/eslint" ] && echo "yes" || true)
HAS_RUFF=$(command -v ruff 2>/dev/null && echo "yes" || true)

# ─── 3. Lint de JS/TS ─────────────────────────────────────────────────────────

JS_FILES=$(echo "$STAGED_FILES" | grep -E "\.(js|jsx|ts|tsx|mjs)$" || true)

if [ -n "$JS_FILES" ] && [ "$HAS_NODE" = "yes" ]; then
  echo "  Lint JS/TS..."

  if [ "$HAS_BIOME" = "yes" ]; then
    echo "$JS_FILES" | xargs node_modules/.bin/biome check --no-errors-on-unmatched 2>/dev/null
    LINT_CODE=$?
  elif [ "$HAS_ESLINT" = "yes" ]; then
    echo "$JS_FILES" | xargs node_modules/.bin/eslint --max-warnings=0 2>/dev/null
    LINT_CODE=$?
  else
    echo "  ⚠️  Sin linter JS/TS instalado (biome o eslint). Saltando lint."
    LINT_CODE=0
  fi

  if [ $LINT_CODE -ne 0 ]; then
    echo "  ❌ Lint falló. Corrige los errores antes de commitear."
    echo "     Ejecuta: npm run lint"
    EXIT_CODE=$LINT_CODE
  else
    echo "  ✓ Lint JS/TS OK."
  fi
fi

# ─── 4. TypeScript type-check ─────────────────────────────────────────────────

TS_FILES=$(echo "$STAGED_FILES" | grep -E "\.(ts|tsx)$" || true)

if [ -n "$TS_FILES" ] && [ "$HAS_NODE" = "yes" ] && [ -f "tsconfig.json" ]; then
  if [ -f "node_modules/.bin/tsc" ]; then
    echo "  Type-check TypeScript..."
    node_modules/.bin/tsc --noEmit --skipLibCheck 2>/dev/null
    TSC_CODE=$?
    if [ $TSC_CODE -ne 0 ]; then
      echo "  ❌ TypeScript: errores de tipo encontrados."
      echo "     Ejecuta: npm run typecheck"
      EXIT_CODE=$TSC_CODE
    else
      echo "  ✓ TypeScript OK."
    fi
  else
    echo "  ⚠️  tsc no encontrado en node_modules. Saltando type-check."
  fi
fi

# ─── 5. Lint Python ───────────────────────────────────────────────────────────

PY_FILES=$(echo "$STAGED_FILES" | grep -E "\.py$" || true)

if [ -n "$PY_FILES" ] && [ "$HAS_RUFF" = "yes" ]; then
  echo "  Lint Python (ruff)..."
  echo "$PY_FILES" | xargs ruff check 2>/dev/null
  RUFF_CODE=$?
  if [ $RUFF_CODE -ne 0 ]; then
    echo "  ❌ ruff falló. Ejecuta: ruff check --fix"
    EXIT_CODE=$RUFF_CODE
  else
    echo "  ✓ Python OK."
  fi
fi

# ─── Resultado final ──────────────────────────────────────────────────────────

if [ $EXIT_CODE -eq 0 ]; then
  echo "✅ pre-commit: todo OK."
else
  echo ""
  echo "❌ pre-commit falló. Corrige los errores antes de commitear."
  echo "   Para saltarte el hook excepcionalmente (no recomendado):"
  echo "   git commit --no-verify -m \"tu mensaje\""
fi

exit $EXIT_CODE
