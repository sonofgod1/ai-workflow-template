#!/usr/bin/env bash
# git-hooks/pre-push
# Corre antes de cada push del usuario.
# Instalar con: cp git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# O usar /git-setup que lo hace automáticamente.

REMOTE="$1"
URL="$2"

echo "🚀 pre-push: verificando antes de push a $REMOTE ($URL)..."

EXIT_CODE=0

# SIN_VERIFICAR marca "pasó, pero quedaron cosas sin comprobar". Va aparte de
# EXIT_CODE a propósito: no bloquea el push, pero tiene que cambiar el mensaje
# final. Cerrar con "✅ OK" después de avisar que nada se verificó es el mismo
# OK falso que este hook venía a eliminar, solo que una pantalla más abajo.
SIN_VERIFICAR=0

# ─── Verificar ────────────────────────────────────────────────────────────────
#
# Delega en .workflow/verify.sh, que es el contrato único de verificación del
# proyecto: sabe lo que el proyecto declaró en verify.conf y, si no hay config,
# autodetecta. La detección por package.json/pyproject.toml que había aquí dejaba
# sin verificar cualquier proyecto Go, Rust, bash, o Python sin pyproject: el hook
# imprimía "✅ OK" sin haber corrido un solo test, que es peor que no tenerlo.

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
VERIFY="$ROOT/.workflow/verify.sh"

if [ -f "$VERIFY" ]; then
  echo "  Ejecutando la verificación del proyecto..."
  bash "$VERIFY"
  VERIFY_CODE=$?

  # verify.sh devuelve 0 tanto en 'ok' como en 'parcial'. La diferencia importa
  # aquí: 'parcial' significa que hay pasos que nadie corrió, y eso no puede
  # pasar por verde en la última puerta antes del remoto.
  RESULTADO=""
  if [ -f "$ROOT/.workflow/.last-verify.json" ] && command -v python3 > /dev/null 2>&1; then
    RESULTADO=$(python3 -c "
import json
try:
    print(json.load(open('$ROOT/.workflow/.last-verify.json', encoding='utf-8')).get('resultado',''))
except Exception:
    print('')
" 2>/dev/null)
  fi

  if [ $VERIFY_CODE -ne 0 ]; then
    echo "  ❌ La verificación falló (ver salida arriba)."
    EXIT_CODE=$VERIFY_CODE
  elif [ "$RESULTADO" = "parcial" ]; then
    echo ""
    echo "  ⚠️  VERIFICACIÓN PARCIAL: hay pasos que no corrió nadie."
    echo "     Esto NO es verde. Lo que subas no está verificado del todo."
    echo "     Revisa arriba qué quedó saltado y por qué (herramienta sin instalar,"
    echo "     o pasos sin declarar en .workflow/verify.conf)."
    echo "     Comprueba tu entorno con: bash .workflow/check-tools.sh"
    echo ""
    echo "     No se bloquea el push: CI es la barrera que sí lo exige."
    SIN_VERIFICAR=1
  elif [ -z "$RESULTADO" ]; then
    echo "  ⚠️  La verificación no reportó error, pero no pude leer su resultado en"
    echo "     .workflow/.last-verify.json (¿falta python3?). Como verify.sh sale con 0"
    echo "     tanto en 'ok' como en 'parcial', no puedo afirmar que no quedara nada saltado."
    SIN_VERIFICAR=1
  else
    echo "  ✓ Verificación OK."
  fi

else
  # Respaldo para proyectos que aún no tienen .workflow/ sincronizado.
  echo "  ⚠️  Sin .workflow/verify.sh. Usando detección básica de stack."

  HAS_NODE=""
  HAS_PYTHON=""
  [ -f "package.json" ] && HAS_NODE="yes"
  [ -f "pyproject.toml" ] && HAS_PYTHON="yes"
  [ -f "setup.py" ] && HAS_PYTHON="yes"

  # CORRIO_ALGO separa "los tests pasaron" de "no hubo tests que correr", que es
  # la confusión que hacía verde a un repo sin suite.
  CORRIO_ALGO=0

  if [ "$HAS_NODE" = "yes" ] && grep -q '"test":' package.json 2>/dev/null; then
    npm test
    TEST_CODE=$?
    CORRIO_ALGO=1
    [ $TEST_CODE -ne 0 ] && { echo "  ❌ Tests JS/TS fallaron."; EXIT_CODE=$TEST_CODE; }
  elif [ "$HAS_NODE" = "yes" ]; then
    echo "  ⚠️  Sin script 'test' en package.json: no se corrió ningún test JS/TS."
  fi

  if [ "$HAS_PYTHON" = "yes" ] && command -v pytest > /dev/null 2>&1; then
    pytest --tb=short
    TEST_CODE=$?
    # pytest devuelve 5 cuando no recolectó ningún test.
    if [ $TEST_CODE -eq 5 ]; then
      echo "  ⚠️  pytest no encontró tests."
    elif [ $TEST_CODE -ne 0 ]; then
      echo "  ❌ Tests Python fallaron."
      EXIT_CODE=$TEST_CODE
      CORRIO_ALGO=1
    else
      CORRIO_ALGO=1
    fi
  elif [ "$HAS_PYTHON" = "yes" ]; then
    echo "  ⚠️  pytest no está instalado: no se corrió ningún test Python."
  fi

  if [ -z "$HAS_NODE" ] && [ -z "$HAS_PYTHON" ]; then
    echo "  ⚠️  Stack no detectado y sin verify.sh: NADA se verificó antes de este push."
    echo "     Sincroniza el workflow o declara los pasos en .workflow/verify.conf."
  fi

  if [ $CORRIO_ALGO -eq 0 ]; then
    SIN_VERIFICAR=1
  fi
fi

# ─── Advertencia si push directo a main ──────────────────────────────────────

CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || true)
if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
  echo ""
  echo "  ⚠️  Push directo a main detectado."
  echo "     Flujo recomendado: feature/* → develop → main"
  echo "     Si es un release o hotfix intencional, continúa."
  echo ""
fi

# ─── Resultado ────────────────────────────────────────────────────────────────

if [ $EXIT_CODE -eq 0 ] && [ $SIN_VERIFICAR -eq 0 ]; then
  echo "✅ pre-push: OK."
elif [ $EXIT_CODE -eq 0 ]; then
  echo "⚠️  pre-push: pasa, pero con cosas SIN VERIFICAR (ver avisos arriba)."
  echo "   No es verde. Si esto es un release, arréglalo antes de seguir."
else
  echo ""
  echo "❌ pre-push falló. Para saltarte el hook excepcionalmente:"
  echo "   git push --no-verify"
fi

exit $EXIT_CODE
